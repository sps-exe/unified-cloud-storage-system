# =============================================================================
# UCSS — Environment Variables Template
# `pnpm setup` copies this to .env and generates the secrets for you.
# NEVER commit .env to git. It is in .gitignore.
# =============================================================================

# ─── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=4000
# Public URL people use to reach this server. Used for the Google redirect and the WebDAV URL.
APP_URL=http://localhost:4000
# Behind a reverse proxy / PaaS (Render, Railway, nginx, Caddy)? Set to 1 so rate limits see real client IPs.
TRUST_PROXY=0

# ─── Database ──────────────────────────────────────────────────────────────────
# Matches docker-compose.yml. Change the password in BOTH places for anything non-local.
POSTGRES_PASSWORD=ucss_dev_password_change_in_prod
DATABASE_URL=postgresql://ucss_user:ucss_dev_password_change_in_prod@localhost:5432/ucss_db

# ─── Secrets (generated by `pnpm setup`) ───────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=REPLACE_WITH_64_BYTE_HEX_STRING_MIN_32_CHARS
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_64_BYTE_HEX_STRING
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# AES-256-GCM key protecting stored Google refresh tokens: exactly 64 hex characters.
# LOSING OR CHANGING THIS KEY makes every connected Drive account unreadable (users must reconnect).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=REPLACE_WITH_EXACTLY_64_HEX_CHARS

# ─── Google OAuth (needed to connect Drive accounts) ───────────────────────────
# Step-by-step guide: docs/google-oauth-setup.md
# Leave blank to start the app anyway; the UI will walk you through it.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Defaults to APP_URL + /api/oauth/google/callback. Register this exact URI in Google Cloud.
GOOGLE_REDIRECT_URI=

# ─── Who can use this server ───────────────────────────────────────────────────
# false = nobody new can sign up (the very first account is always allowed).
ALLOW_REGISTRATION=true
# Largest single file accepted, in bytes (default 2 GiB). Files are spooled to disk, not RAM.
MAX_UPLOAD_BYTES=2147483648

# ─── Optional ──────────────────────────────────────────────────────────────────
# Extra browser origin allowed by CORS, e.g. the Vite dev server (pnpm dev).
FRONTEND_URL=http://localhost:5173
# Where in-flight uploads are spooled (default: OS temp dir).
UPLOAD_TMP_DIR=
# Minutes between background reconciliation runs (stuck uploads, quota drift). 0 disables.
RECONCILE_INTERVAL_MINUTES=10

# ─── Storage allocation ────────────────────────────────────────────────────────
# Free bytes always kept in each Drive account (500 MiB default)
QUOTA_SAFETY_MARGIN_BYTES=524288000
QUOTA_STALE_THRESHOLD_SECONDS=300

# ─── Reconciliation thresholds ─────────────────────────────────────────────────
STUCK_UPLOAD_THRESHOLD_MINUTES=30
STUCK_PENDING_THRESHOLD_MINUTES=5
