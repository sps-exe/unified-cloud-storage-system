# =============================================================================
# UCSS — Environment Variables Template
# Copy this file to .env and fill in the values.
# NEVER commit .env to git. It is in .gitignore.
# =============================================================================

# ─── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ─── Database (Docker Compose defaults) ────────────────────────────────────────
DATABASE_URL=postgresql://ucss_user:ucss_dev_password_change_in_prod@localhost:5432/ucss_db

# ─── JWT Secrets ───────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=REPLACE_WITH_64_BYTE_HEX_STRING_MIN_32_CHARS
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_64_BYTE_HEX_STRING

# Access tokens expire in 24 hours, refresh tokens in 30 days
JWT_ACCESS_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=30d

# ─── Token Encryption Key ──────────────────────────────────────────────────────
# Must be exactly 64 hex characters (= 32 bytes for AES-256-GCM)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=REPLACE_WITH_EXACTLY_64_HEX_CHARS

# ─── Google OAuth ───────────────────────────────────────────────────────────────
# Get from: https://console.cloud.google.com/apis/credentials
# Create an OAuth 2.0 Client ID for a Web Application
# Add http://localhost:4000/api/oauth/google/callback to Authorized redirect URIs
GOOGLE_CLIENT_ID=REPLACE_WITH_YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=REPLACE_WITH_YOUR_GOOGLE_CLIENT_SECRET
GOOGLE_REDIRECT_URI=http://localhost:4000/api/oauth/google/callback

# ─── Frontend URL (for CORS) ────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ─── Storage Allocation ─────────────────────────────────────────────────────────
# Safety margin: minimum free bytes to always keep in each account (500MB default)
QUOTA_SAFETY_MARGIN_BYTES=524288000
# Treat quota as stale after N seconds (5 minutes = 300 seconds)
QUOTA_STALE_THRESHOLD_SECONDS=300

# ─── Reconciliation ─────────────────────────────────────────────────────────────
# How long before an UPLOADING file is considered stuck (minutes)
STUCK_UPLOAD_THRESHOLD_MINUTES=30
# How long before a PENDING file is considered stuck (minutes)
STUCK_PENDING_THRESHOLD_MINUTES=5
