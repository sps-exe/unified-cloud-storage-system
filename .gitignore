# ─── Environment Files (NEVER commit secrets) ─────────────────────────────────
.env
.env.*
!.env.example
*.env

# ─── Dependencies ─────────────────────────────────────────────────────────────
node_modules/
.pnpm-store/

# ─── Build Outputs ─────────────────────────────────────────────────────────────
dist/
build/
*.js.map
*.d.ts.map
apps/api/dist/
apps/web/dist/

# ─── Process & Runtime Artifacts ──────────────────────────────────────────────
*.pid
*.log
logs/
pino.log
*.sample.txt

# ─── Turbo Cache ───────────────────────────────────────────────────────────────
.turbo/

# ─── Prisma Generated ─────────────────────────────────────────────────────────
packages/database/node_modules/.prisma/

# ─── Testing & Coverage ───────────────────────────────────────────────────────
coverage/
.nyc_output/

# ─── OS Files ─────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ─── IDE & Editor ─────────────────────────────────────────────────────────────
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*.swo

# ─── Temporary Upload Files ───────────────────────────────────────────────────
uploads/
tmp/
temp/
